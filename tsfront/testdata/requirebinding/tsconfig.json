{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowJs": true,
    "paths": {
      "@fake/core": ["./fake-core/index.ts"],
      "@fake/transpiler/build/src/rearranger": ["./fake-transpiler/rearranger.ts"]
